# Copy this file to .env.local and fill in real values for your deployment.
# .env.local is gitignored — never commit real secrets.

# The site's real public URL. Used in metadata, the sitemap, robots.txt,
# and the JSON-LD structured data. Falls back to a placeholder .example
# domain if unset — see src/lib/siteUrl.ts.
NEXT_PUBLIC_SITE_URL=https://apexauto.co.uk

# Enquiry form email delivery (via Resend — see README "Setting up enquiry
# emails" for how to get these). Without all three set, the /book page's
# enquiry form still works, but just logs enquiries to the server console
# instead of emailing them — fine for local dev, not for production.
RESEND_API_KEY=re_123456789
ENQUIRY_TO_EMAIL=owner@apexauto.co.uk
ENQUIRY_FROM_EMAIL=bookings@apexauto.co.uk
