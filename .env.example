# The site's real public URL. Used in metadata, the sitemap, robots.txt,
# and the JSON-LD structured data. Falls back to a placeholder .example
# domain if unset — see src/lib/siteUrl.ts.
NEXT_PUBLIC_SITE_URL=https://apexauto.co.uk
